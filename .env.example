# Daybook production environment. Set the same variables in Vercel.

# Database: Supabase > Connect > Transaction pooler connection string (port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Optional: your numeric chat id. Leave empty and the first /start locks the bot to you.
TELEGRAM_OWNER_CHAT_ID=

# Supabase Auth (email magic link)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Voice input
DEEPGRAM_API_KEY=

# Scheduler secret (Supabase Cron sends it with every tick)
CRON_SECRET=

# The public https address of the deployed app
APP_BASE_URL=http://localhost:3000
